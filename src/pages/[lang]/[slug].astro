---
import ConservatoryPage from "../../components/pages/ConservatoryPage.astro";
import InsectScreensPage from "../../components/pages/InsectScreensPage.astro";
import InteriorShadingPage from "../../components/pages/InteriorShadingPage.astro";
import LegalPage from "../../components/pages/LegalPage.astro";
import PrivacyPage from "../../components/pages/PrivacyPage.astro";
import ProductPage, { type ProductPageKey } from "../../components/pages/ProductPage.astro";
import { languages, pageKeys, slugs, type Lang, type PageKey } from "../../i18n";

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    pageKeys
      .filter((page) => page !== "home")
      .map((page) => ({ params: { lang, slug: slugs[page][lang] }, props: { page } })),
  );
}

const lang = Astro.params.lang as Lang;
const { page } = Astro.props as { page: Exclude<PageKey, "home"> };
---

{
  page === "interiorShading" ? (
    <InteriorShadingPage lang={lang} />
  ) : page === "insectScreens" ? (
    <InsectScreensPage lang={lang} />
  ) : page === "conservatoryShading" ? (
    <ConservatoryPage lang={lang} />
  ) : page === "legal" ? (
    <LegalPage lang={lang} />
  ) : page === "privacy" ? (
    <PrivacyPage lang={lang} />
  ) : (
    <ProductPage lang={lang} page={page as ProductPageKey} />
  )
}
