---
import { pageUrl, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang).ui;
---

<footer class="text-center py-4 references-section fullpage-footer">
  <small>
    © {new Date().getFullYear()} StarkFix Austria. {ui.allRightsReserved} |
    <a href={pageUrl("legal", lang)} class="text-primary">{ui.legalLink}</a> |
    <a href={pageUrl("privacy", lang)} class="text-primary">{ui.privacyLink}</a>
  </small>
</footer>
