---
import Layout from "../../layouts/Layout.astro";
import Picture from "../Picture.astro";
import { company } from "../../data/company";
import { pageUrl, t, type Lang } from "../../i18n";

// A nyitókép előtti zsalu lamelláinak száma (javascript/design.js mozgatja őket).
const slatCount = 18;

const heroPicture = "/images/references/linz-harbour/linz-harbour-1.webp";

// Termékrács: a "wide" kártya szélesebb. Az oldal tetszőleges sorrendben átrendezhető,
// a napellenzőnek még nincs fotója, ezért ott rajzolt grafika jelenik meg.
const tiles = [
  { page: "shutters", picture: "/images/products/shutters.webp", wide: true },
  { page: "venetianBlinds", picture: "/images/references/venetian-blind-conversion/venetian-blind-conversion-1.webp", wide: true },
  { page: "outdoorRollerBlinds", picture: "/images/products/outdoor-roller-blind-green.webp", wide: false },
  { page: "interiorShading", picture: "/images/products/interior-venetian-blind.webp", wide: false },
  { page: "conservatoryShading", picture: "/images/products/conservatory-shading-1.webp", wide: false },
  { page: "pergolas", picture: "/images/products/pergola.webp", wide: true },
  { page: "awnings", picture: null, wide: true },
  { page: "insectScreens", picture: "/images/products/insect-screen-pleated.webp", wide: true },
  { page: "service", picture: "/images/products/service.webp", wide: true },
] as const;

// Pictures of each reference card (the first one is the thumbnail); texts are in the language files.
const referencePictures = [
  [
    "/images/references/linz-harbour/linz-harbour-1.webp",
    "/images/references/linz-harbour/linz-harbour-2.webp",
    "/images/references/linz-harbour/linz-harbour-3.webp",
    "/images/references/linz-harbour/linz-harbour-4.webp",
  ],
  ["/images/references/venetian-blind-conversion/venetian-blind-conversion-1.webp", "/images/references/venetian-blind-conversion/venetian-blind-conversion-2.webp", "/images/references/venetian-blind-conversion/venetian-blind-conversion-3.webp"],
  [
    "/images/references/conservatory-slanted-windows/conservatory-slanted-windows-1.webp",
    "/images/references/conservatory-slanted-windows/conservatory-slanted-windows-2.webp",
    "/images/references/conservatory-slanted-windows/conservatory-slanted-windows-3.webp",
  ],
];

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { ui, home: text } = t(lang);
---

<Layout lang={lang} page="home" meta={text.meta}>
  <header id="hero-reference" class="hero">
    <div class="hero-copy">
      <p class="eyebrow">StarkFix Austria · Fix for you</p>
      <h1 class="hero-title">{text.heroTitle}</h1>
      <div class="hero-actions">
        <a class="pill pill--solid" href="#services">{ui.nav.products}</a>
        <a class="pill pill--quiet" href="#contact">{ui.nav.contact}</a>
      </div>
    </div>

    <!-- Az ablak: a fotó előtt igazi lamellák. JavaScript nélkül csak a fotó látszik. -->
    <figure class="window">
      <Picture
        src={heroPicture}
        alt={text.references[0].title}
        class="window-photo"
        sizes="(max-width: 1200px) 100vw, 1200px"
        width={1200}
        height={675}
        priority
      />
      <div class="blinds" aria-hidden="true">
        <span class="blinds-dim"></span>
        <span class="blinds-rail"></span>
        <span class="blinds-cord blinds-cord--left"></span>
        <span class="blinds-cord blinds-cord--right"></span>
        <div class="blinds-slats">
          {Array.from({ length: slatCount }, () => <span class="slat"></span>)}
        </div>
      </div>
    </figure>

    <div class="light-control">
      <span class="light-end" aria-hidden="true">{text.lightClosed}</span>
      <input
        id="light-slider"
        class="light-slider"
        type="range"
        min="0"
        max="100"
        value="72"
        aria-label={text.lightLabel}
      />
      <span class="light-end" aria-hidden="true">{text.lightOpen}</span>
    </div>
    <p class="light-hint">{text.lightHint}</p>
  </header>

  <main>
    <section id="about" class="about">
      <!-- Az a fény, amit fent a látogató beenged: a csíkok erősségét a lamellák állása adja. -->
      <div class="sun-band" aria-hidden="true"></div>
      <div class="about-inner reveal">
        <p class="eyebrow">{text.aboutTitle}</p>
        <h2 class="visually-hidden">{text.aboutTitle}</h2>
        <p class="about-text">{text.aboutText}</p>
      </div>
    </section>

    <section id="services" class="products">
      <div class="section-head reveal">
        <h2>{text.productsTitle}</h2>
      </div>
      <div class="tile-grid">
        {
          tiles.map((tile) => (
            <a href={pageUrl(tile.page, lang)} class:list={["tile", "reveal", { "tile--wide": tile.wide, "tile--drawn": !tile.picture }]}>
              {tile.picture ? (
                <Picture
                  src={tile.picture}
                  alt=""
                  class="tile-photo"
                  sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 600px"
                  width={800}
                  height={600}
                  lazy
                />
              ) : (
                <svg class="tile-awning" viewBox="0 0 400 150" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 0h400v96a25 25 0 0 1-50 0 25 25 0 0 1-50 0 25 25 0 0 1-50 0 25 25 0 0 1-50 0 25 25 0 0 1-50 0 25 25 0 0 1-50 0 25 25 0 0 1-50 0 25 25 0 0 1-50 0z" />
                </svg>
              )}
              <div class="tile-text">
                <h3 class="tile-title">{text.products[tile.page].title}</h3>
                <p class="tile-tagline">{text.products[tile.page].tagline}</p>
              </div>
              <span class="tile-arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section id="references" class="references">
      <div class="section-head reveal">
        <h2>{text.referencesTitle}</h2>
      </div>
      <div class="rail">
        {
          text.references.map((reference, i) => (
            <button
              type="button"
              class="reference-card rail-card"
              data-bs-toggle="modal"
              data-bs-target="#referenceModal"
              data-title={reference.title}
              data-images={referencePictures[i].join(",")}
              data-desc={reference.description}
            >
              <span class="rail-frame reveal-image">
                <Picture
                  src={referencePictures[i][0]}
                  alt=""
                  class="rail-photo"
                  sizes="(max-width: 640px) 85vw, 520px"
                  width={800}
                  height={600}
                  lazy
                />
              </span>
              <span class="rail-title">{reference.title}</span>
              <span class="rail-desc">{reference.description}</span>
            </button>
          ))
        }
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="contact-panel reveal">
        <p class="eyebrow">{text.contactTitle}</p>
        <h2 class="contact-title">{text.contactNote}</h2>
        <div class="contact-links">
          <a class="contact-link" href={company.phoneHref}>
            <span class="contact-label">{text.phoneLabel}</span>
            {company.phone}
          </a>
          <div class="contact-mail">
            <a class="contact-link" href={`mailto:${company.email}`}>
              <span class="contact-label">E-Mail:</span>
              {company.email}
            </a>
            <!-- Másolás gomb: a felirat elmosódva vált, hogy egy állapotváltásnak hasson. -->
            <button type="button" class="copy-button" data-copy={company.email} data-copied={text.copied}>
              <span class="copy-label">{text.copyEmail}</span>
            </button>
          </div>
        </div>
        <p class="contact-address">
          <span class="contact-label">{text.addressLabel}</span>
          {company.businessAddress.postalCity}, {company.businessAddress.street}
        </p>
      </div>
    </section>
  </main>
</Layout>
