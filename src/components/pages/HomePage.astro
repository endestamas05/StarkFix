---
import Layout from "../../layouts/Layout.astro";
import Picture from "../Picture.astro";
import { company } from "../../data/company";
import { pageUrl, t, type Lang } from "../../i18n";

const heroPictures = [
  "/images/references/venetian-blind-conversion/venetian-blind-conversion-1.webp",
  "/images/references/conservatory-slanted-windows/conservatory-slanted-windows-1.webp",
  "/images/references/linz-harbour/linz-harbour-1.webp",
  "/images/references/turquoise-outdoor-roller-blinds.webp",
  "/images/products/conservatory-shading-1.webp",
];

const productOrder = [
  "shutters",
  "venetianBlinds",
  "outdoorRollerBlinds",
  "interiorShading",
  "conservatoryShading",
  "pergolas",
  "awnings",
  "insectScreens",
  "service",
] as const;

// Pictures of each reference card (the first one is the thumbnail); texts are in the language files.
const referencePictures = [
  [
    "/images/references/linz-harbour/linz-harbour-1.webp",
    "/images/references/linz-harbour/linz-harbour-2.webp",
    "/images/references/linz-harbour/linz-harbour-3.webp",
    "/images/references/linz-harbour/linz-harbour-4.webp",
  ],
  ["/images/references/venetian-blind-conversion/venetian-blind-conversion-1.webp", "/images/references/venetian-blind-conversion/venetian-blind-conversion-2.webp", "/images/references/venetian-blind-conversion/venetian-blind-conversion-3.webp"],
  [
    "/images/references/conservatory-slanted-windows/conservatory-slanted-windows-1.webp",
    "/images/references/conservatory-slanted-windows/conservatory-slanted-windows-2.webp",
    "/images/references/conservatory-slanted-windows/conservatory-slanted-windows-3.webp",
  ],
];

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { ui, home: text } = t(lang);
---

<Layout lang={lang} page="home" meta={text.meta}>
  <header id="hero-reference" class="d-flex flex-column justify-content-center align-items-center">
    <div
      id="heroCarousel"
      class="carousel slide carousel-fade w-100 h-100 position-relative"
      data-bs-ride="carousel"
      data-bs-interval="8000"
    >
      <div class="carousel-inner h-100">
        {
          heroPictures.map((src, i) => (
            <div class={i === 0 ? "carousel-item h-100 active" : "carousel-item h-100"}>
              <Picture
                src={src}
                alt={text.heroAlt(i + 1)}
                class="d-block w-100 hero-img"
                sizes="(max-width: 575px) 100vw, (max-width: 991px) 80vw, 1200px"
                width={1200}
                height={600}
                priority={i === 0}
                lazy={i > 0}
              />
            </div>
          ))
        }
      </div>
      <div class="carousel-indicators custom-indicators">
        {
          heroPictures.map((_, i) => (
            <button
              type="button"
              data-bs-target="#heroCarousel"
              data-bs-slide-to={i}
              class={i === 0 ? "active" : undefined}
              aria-current={i === 0 ? "true" : undefined}
              aria-label={ui.image(i + 1)}
              style="min-width: 15px; min-height: 15px; margin: 4px"
            />
          ))
        }
      </div>
      <div class="carousel-controls-custom">
        <button
          class="carousel-control-prev"
          type="button"
          data-bs-target="#heroCarousel"
          data-bs-slide="prev"
          aria-label={ui.previousImage}
          style="min-width: 50px; min-height: 50px; margin: 4px"
        >
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">{ui.previous}</span>
        </button>
        <button
          class="carousel-control-next"
          type="button"
          data-bs-target="#heroCarousel"
          data-bs-slide="next"
          aria-label={ui.nextImage}
          style="min-width: 50px; min-height: 50px; margin: 4px"
        >
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">{ui.next}</span>
        </button>
      </div>
    </div>
    <div class="hero-caption text-center text-white position-absolute w-100" style="top: 0; left: 0">
      <h1 class="display-4 fw-bold">StarkFix Austria</h1>
      <p class="fix-for-you">Fix for you</p>
    </div>
  </header>

  <main>
  <section id="about" class="container-fluid about-section shadow">
    <div class="row justify-content-center align-items-center">
      <div class="col-lg-6 text-center text-lg-start">
        <h2 class="mb-3">{text.aboutTitle}</h2>
        <p>{text.aboutText}</p>
      </div>
      <div class="col-lg-6 d-none d-lg-block">
        <!-- Shutter illustration -->
        <svg width="100%" height="120" viewBox="0 0 400 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="theme-svg">
          <rect x="10" y="10" width="380" height="100" rx="18" fill="var(--primary-color-light)" stroke="var(--primary-color)" stroke-width="4" class="svg-rect-bg"></rect>
          <rect x="20" y="25" width="360" height="12" rx="4" fill="var(--primary-color)" opacity="0.7" class="svg-rect"></rect>
          <rect x="20" y="45" width="360" height="12" rx="4" fill="var(--primary-color)" opacity="0.5" class="svg-rect"></rect>
          <rect x="20" y="65" width="360" height="12" rx="4" fill="var(--primary-color)" opacity="0.7" class="svg-rect"></rect>
          <rect x="20" y="85" width="360" height="12" rx="4" fill="var(--primary-color)" opacity="0.5" class="svg-rect"></rect>
        </svg>
      </div>
    </div>
  </section>

  <section id="services" class="container-fluid services-section shadow">
    <h2 class="mb-4 text-center">{text.productsTitle}</h2>
    <div class="row g-4">
      {
        productOrder.map((page, i) => (
          <div class={i === productOrder.length - 1 ? "col-md-4 col-sm-12" : "col-md-4 col-sm-6"}>
            <a href={pageUrl(page, lang)} class="text-decoration-none text-reset">
              <div class="card h-100 text-center p-3">
                <div class="card-body">
                  <h3 class="card-title h5">{text.products[page].title}</h3>
                  <p class="card-text fst-italic">{text.products[page].tagline}</p>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section id="references" class="container-fluid references-section shadow py-5">
    <h2 class="mb-4 text-center fw-bold references-title">{text.referencesTitle}</h2>
    <div class="row g-4 justify-content-center">
      {
        text.references.map((reference, i) => (
          <div class="col-md-4">
            <div
              class="card reference-card h-100 border-0 p-3"
              data-bs-toggle="modal"
              data-bs-target="#referenceModal"
              data-title={reference.title}
              data-images={referencePictures[i].join(",")}
              data-desc={reference.description}
            >
              <Picture
                src={referencePictures[i][0]}
                alt={reference.title}
                class="img-fluid shadow"
                sizes="(max-width: 575px) 100vw, (max-width: 991px) 50vw, 400px"
                width={400}
                height={250}
                lazy
              />
              <div class="card-body">
                <h3 class="card-title h5">{reference.title}</h3>
                <p class="card-text text-secondary fst-italic">{reference.description}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="contact" class="container-fluid contact-section shadow rounded-0 mb-0">
    <h2 class="mb-3 text-center">{text.contactTitle}</h2>
    <div class="row justify-content-center">
      <div class="col-md-6 contact-info text-center p-5">
        <p>
          <strong>Email:</strong>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
        <p>
          <strong>{text.phoneLabel}</strong>
          <a href={company.phoneHref}>{company.phone}</a>
        </p>
        <p><strong>{text.addressLabel}</strong> {company.businessAddress.postalCity}, {company.businessAddress.street}</p>
        <p class="mt-3 text-secondary" style="font-size: 0.95rem">{text.contactNote}</p>
      </div>
    </div>
  </section>
  </main>
</Layout>
