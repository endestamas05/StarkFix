---
import { contentSizes, srcsetFor } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  class: string;
  width?: number;
  height?: number;
  sizes?: string;
  lazy?: boolean;
  /** The most important picture of the page (loaded first). */
  priority?: boolean;
}

const {
  src,
  alt,
  class: className,
  width = 800,
  height = 400,
  sizes = contentSizes,
  lazy = false,
  priority = false,
} = Astro.props;
const srcset = srcsetFor(src);
---

<img
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  class={className}
  width={width}
  height={height}
  loading={lazy ? "lazy" : undefined}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
/>
