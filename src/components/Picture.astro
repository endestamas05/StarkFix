---
import { contentSizes, srcsetFor } from "../lib/images";
import { pictureAlt } from "../data/pictureAlts";
import type { Lang } from "../i18n/routes";

interface Props {
  src: string;
  alt: string;
  class: string;
  width?: number;
  height?: number;
  sizes?: string;
  lazy?: boolean;
  /** The most important picture of the page (loaded first). */
  priority?: boolean;
}

const {
  src,
  alt,
  class: className,
  width = 800,
  height = 400,
  sizes = contentSizes,
  lazy = false,
  priority = false,
} = Astro.props;
const srcset = srcsetFor(src);
// Az oldal nyelve az URL elején van (/de/…, /en/…, /hu/…).
const lang = Astro.url.pathname.split("/")[1] as Lang;
const description = pictureAlt(src, lang) ?? alt;
---

<img
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={description}
  class={className}
  width={width}
  height={height}
  loading={lazy ? "lazy" : undefined}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
/>
